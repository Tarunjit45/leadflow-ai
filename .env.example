# ==============================================================================
# LEADFLOW AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application & Environment
PROJECT_NAME="LeadFlow AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
APP_URL="http://localhost:3000"

# Security Secrets (Must be 32+ characters in production)
SECRET_KEY="leadflow-super-secure-master-secret-key-32-chars-minimum-prod"
ENCRYPTION_KEY="dGhpcy1pcy1hLXNlY3VyZS0zMi1ieXRlLWtleS1leGFtcGxlIQ=="

# Database Engine (PostgreSQL in production, SQLite in local dev)
DATABASE_URL="sqlite:///./leadflow_local.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/leadflow_db"

# Background Job Queue (Redis)
REDIS_URL="redis://localhost:6379/0"

# AI Provider Abstraction (Default: OpenRouter)
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
AI_FALLBACK_MODEL="anthropic/claude-3.5-haiku"

# ==============================================================================
# PAYMENT PROVIDER ABSTRACTION (Primary Default: Razorpay)
# ==============================================================================
# Choose active provider: "razorpay" (recommended for India & International SaaS) or "stripe"
PAYMENT_PROVIDER="razorpay"
BILLING_CURRENCY="USD"

# --- Razorpay Configuration (Primary) ---
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER_MONTHLY="plan_starter_99_usd"
RAZORPAY_PLAN_GROWTH_MONTHLY="plan_growth_199_usd"

# --- Stripe Configuration (Modular Secondary) ---
# Obtain from: https://dashboard.stripe.com/apikeys
# Note: Neither Stripe keys nor Razorpay keys are required when the other is active.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly_99"
STRIPE_PRICE_GROWTH_MONTHLY="price_growth_monthly_199"

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================

# Meta WhatsApp Cloud API (Official Meta Business Platform)
# Obtain from: https://developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="leadflow_whatsapp_webhook_verify_token"
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""

# Google Calendar & Sheets OAuth 2.0
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google/callback"

# Demo Sandbox
ENABLE_DEMO_MODE=true
DEMO_BUSINESS_ID="biz_demo_hvac_001"
