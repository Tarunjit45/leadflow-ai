# ==============================================================================
# LeadFlow AI - Environment Variables Configuration Template
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend Secret & Cryptography
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ENCRYPTION_KEY=dGhpcy1pcy1hLXNlY3VyZS0zMi1ieXRlLWtleS1leGFtcGxlIQ==
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-nextauth-secret-for-jwt-signing

# Database (PostgreSQL)
DATABASE_URL=postgresql://leadflow_user:leadflow_password@localhost:5432/leadflow_db
# For SQLite testing fallback if local Postgres is not started:
# DATABASE_URL=sqlite:///./leadflow_dev.db

# Queue / Background Jobs (Redis)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Default: OpenRouter)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-example-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODEL=anthropic/claude-3.5-haiku

# Google OAuth & Calendar Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Meta / WhatsApp Cloud API Integration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=leadflow_whatsapp_webhook_verification_token_secret
META_ACCESS_TOKEN=your-system-user-or-permanent-meta-access-token
META_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
META_WABA_ID=your-whatsapp-business-account-id

# Stripe Payments & Subscriptions
STRIPE_SECRET_KEY=sk_test_example_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_example_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_example_stripe_webhook_signing_secret
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_99
STRIPE_PRICE_GROWTH_MONTHLY=price_growth_monthly_199

# Demo Mode Settings
ENABLE_DEMO_MODE=true
DEMO_BUSINESS_ID=biz_demo_hvac_pro_001
